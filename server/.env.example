# Copia este archivo como ".env" y llena tus datos reales
# NUNCA subas el archivo ".env" real a GitHub

# Servidor
PORT=4000

# Base de datos MySQL
# ── Opción A: local con XAMPP/WAMP ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexova_studio
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ── Opción B: en la nube (TiDB Cloud Serverless) ──
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=nexova_studio
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=tu-password-de-tidb
# DB_SSL=true

# Frontend (CORS). Varias URLs separadas por coma
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Clave para firmar las sesiones (JWT). Pon una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Aviso por correo cuando llega un mensaje del formulario (opcional, usa https://resend.com)
# Si no los pones, el formulario funciona igual pero no te avisa.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFY_EMAIL=tu-correo@gmail.com
