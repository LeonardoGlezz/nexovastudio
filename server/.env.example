# Copia este archivo como ".env" y llena tus datos reales
# NUNCA subas el archivo ".env" real a GitHub

# Servidor
PORT=4000

# Base de datos MySQL (local con XAMPP/WAMP, o servicio en la nube)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexova_studio
DB_USER=root
DB_PASSWORD=

# Frontend (para permitir CORS)
CLIENT_URL=http://localhost:5173
